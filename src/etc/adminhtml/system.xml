<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="infrangible_sitemap" translate="label" type="text" sortOrder="500" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Sitemap</label>
            <tab>infrangible</tab>
            <resource>Infrangible_Sitemap::config_infrangible_sitemap</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="export" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Export</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="file_name" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>File Name</label>
                    <depends>
                        <field id="export">1</field>
                    </depends>
                </field>
                <field id="main" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Generate Main Sitemap</label>
                    <comment>In case website/store specific files are generated.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="export">1</field>
                    </depends>
                </field>
            </group>
            <group id="product" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Product</label>
                <field id="export" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Export</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="changeFrequency" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Change Frequency</label>
                    <source_model>Infrangible\Sitemap\Model\Config\Source\ChangeFrequency</source_model>
                    <depends>
                        <field id="export">1</field>
                    </depends>
                </field>
                <field id="priority" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Priority</label>
                    <depends>
                        <field id="export">1</field>
                    </depends>
                </field>
            </group>
            <group id="category" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Category</label>
                <field id="export" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Export</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="changeFrequency" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Change Frequency</label>
                    <source_model>Infrangible\Sitemap\Model\Config\Source\ChangeFrequency</source_model>
                    <depends>
                        <field id="export">1</field>
                    </depends>
                </field>
                <field id="priority" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Priority</label>
                    <depends>
                        <field id="export">1</field>
                    </depends>
                </field>
            </group>
            <group id="cms" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>CMS</label>
                <field id="export" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Export</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="changeFrequency" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Change Frequency</label>
                    <source_model>Infrangible\Sitemap\Model\Config\Source\ChangeFrequency</source_model>
                    <depends>
                        <field id="export">1</field>
                    </depends>
                </field>
                <field id="priority" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Priority</label>
                    <depends>
                        <field id="export">1</field>
                    </depends>
                </field>
            </group>
        </section>
        <section id="task_sitemap" translate="label" type="text" sortOrder="500" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Sitemap</label>
            <tab>tasks</tab>
            <resource>Infrangible_Sitemap::config_infrangible_sitemap</resource>
            <group id="execution" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Execution</label>
                <field id="cron_expression" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Cron Expression</label>
                    <backend_model>Infrangible\Sitemap\Task\Cron\Execution\Sitemap</backend_model>
                </field>
            </group>
        </section>
    </system>
</config>
