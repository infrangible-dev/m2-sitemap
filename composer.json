{
    "name": "infrangible/m2-sitemap",
    "description": "Generates XML sitemaps for products (with images), categories and CMS pages per store view, on a schedule or on demand, with exclusion options and large-catalog splitting.",
    "type": "magento2-module",
    "version": "3.0.0",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Sitemaps",
        "SEO",
        "XML sitemap with images",
        "large catalog sitemap",
        "sitemap per store view"
    ],
    "homepage": "https://www.infrangible.dev/modules/sitemap",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@infrangible.dev",
            "homepage": "https://www.infrangible.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "fewedev/base": "~2.4.1",
        "infrangible/m2-backend-widget": "~4.0.4",
        "infrangible/m2-core": "~5.0.4",
        "infrangible/m2-foundation": "~3.0.1",
        "infrangible/m2-simple-mail": "~2.0.0",
        "infrangible/m2-task": "~3.0.0",
        "magento/framework": "~103.0.6",
        "magento/module-backend": "~102.0.0",
        "magento/module-catalog": "~104.0.0",
        "magento/module-cms": "~104.0.0",
        "magento/module-config": "~101.2.0",
        "magento/module-eav": "~102.1.0",
        "magento/module-store": "~101.1.0",
        "magento/module-ui": "~101.2.0",
        "psr/log": "~2.0.0||~3.0.0"
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\Sitemap\\": "src"
        }
    }
}
